# Copy to .env.local. Values here are local-development defaults, not secrets.

# API address used by the browser (login link, Axios). NEXT_PUBLIC_* values are
# inlined into the client bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: API address used by server-side code (session lookup) when it
# differs from the browser address, e.g. http://backend:8000 inside Docker.
# API_INTERNAL_URL=
