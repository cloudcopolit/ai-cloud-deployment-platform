# Docker Compose settings for local development and testing.
# Copy to `.env` (ignored by Git) for development. These are local-only
# placeholder values: NEVER use this file, or any of these values, in production.

ENVIRONMENT=development

POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=cloudpilot-dev-only
POSTGRES_DB=cloudpilot

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-not-a-secret-change-me-0123456789abcdefghijklmn

# GitHub OAuth App (callback: http://localhost:8000/auth/github/callback).
# Placeholders let the stack start; GitHub sign-in needs real values, while
# POST /auth/dev-login works with the seeded users.
GITHUB_CLIENT_ID=replace-with-your-client-id
GITHUB_CLIENT_SECRET=replace-with-your-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

FRONTEND_URL=http://localhost:3000
# API address as seen by the browser (inlined into the frontend build).
PUBLIC_API_URL=http://localhost:8000

# Published ports (development) / bind address (production).
# DB_PORT=5432
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# BIND_ADDRESS=127.0.0.1
