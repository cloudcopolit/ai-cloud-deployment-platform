# Docker Compose settings for local development and testing.
# Copy to `.env` (ignored by Git) for development.
# These are local-only placeholder values: NEVER use this file or real secrets in production.

ENVIRONMENT=development
SEED_DEV_DATA=true

POSTGRES_USER=cloudpilot
POSTGRES_PASSWORD=cloudpilot-dev-only
POSTGRES_DB=cloudpilot

# Generate your own: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-only-not-a-secret-change-me-0123456789abcdefghijklmn

# GitHub sign-in (OAuth App, identity only)
GITHUB_CLIENT_ID=replace-with-your-client-id
GITHUB_CLIENT_SECRET=replace-with-your-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# GitHub repository access (ADR-021). All optional. Without them CloudPilot reads public
# repositories anonymously (60 GitHub API requests per hour).
# A fine-grained token with public-repository read access raises that to 5000/hour.
GITHUB_TOKEN=
# GitHub App for private repositories. Needs repository permissions Contents: read and
# Metadata: read, the "push" event, and an installation on the repositories to analyze.
# Its private key goes in ./secrets/github-app.pem (git-ignored, mounted read-only).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Enables POST /webhooks/github (HMAC-verified). The endpoint answers 404 while empty.
GITHUB_WEBHOOK_SECRET=

# LocalStack AWS Simulation
AWS_ENDPOINT_URL=http://localstack:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LLM Providers (Names only - API keys are optional for mocked tests)
LLM_PROVIDER_PRIORITY=anthropic,openai,gemini,xai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Published ports (optional overrides)
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Architecture: priced, deployable patterns (ADR-023). false = prototype template only.
ARCHITECT_AUTOMATED_ARCHETYPES=false

# CloudPilot's own AWS identity (ADR-028), used to assume customer roles. Separate from the
# LocalStack AWS_* values above. Empty = deployments disabled.
CLOUDPILOT_AWS_ACCESS_KEY_ID=
CLOUDPILOT_AWS_SECRET_ACCESS_KEY=
CLOUDPILOT_AWS_REGION=us-east-1
CLOUDPILOT_AWS_ENDPOINT_URL=
