# Backend environment configuration
DATABASE_URL=postgresql+psycopg://cloudpilot:cloudpilot@localhost:5432/cloudpilot
ENVIRONMENT=development
SEED_DEV_DATA=true

# Security
JWT_SECRET_KEY=replace-with-a-generated-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:3000

# GitHub Integration
GITHUB_CLIENT_ID=replace-with-your-client-id
GITHUB_CLIENT_SECRET=replace-with-your-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_TOKEN=optional-github-pat-for-higher-rate-limits

# LocalStack / AWS
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LLM Providers (Names only)
LLM_PROVIDER_PRIORITY=anthropic,openai,gemini,xai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
