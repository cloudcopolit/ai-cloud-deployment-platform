# Copy to .env and replace the placeholders. Never commit the real .env file.
DATABASE_URL=postgresql+psycopg://cloudpilot:cloudpilot@localhost:5432/cloudpilot
ENVIRONMENT=development

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-generated-secret

# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
GITHUB_CLIENT_ID=replace-with-your-client-id
GITHUB_CLIENT_SECRET=replace-with-your-client-secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

FRONTEND_URL=http://localhost:3000
